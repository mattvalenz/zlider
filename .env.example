# Supabase: Project Settings → API (not Database → connection string)
# URL must be https://<project-ref>.supabase.co — never postgresql://...
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use either name (dashboard may show "anon" JWT or "publishable" sb_ key):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google AI Studio / Gemini API — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Application → Access Key (Authorization: Client-ID …). Not the Secret Key. Restart dev server after changes.
UNSPLASH_ACCESS_KEY=
